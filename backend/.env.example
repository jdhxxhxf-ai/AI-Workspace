# AI Workspace Backend — Environment Configuration

# Application
APP_NAME=AI Workspace API
APP_VERSION=0.1.0
DEBUG=false

# Logging
LOG_LEVEL=INFO

# LLM Provider (default: ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# OpenAI (Stage 3+)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Workspace
DEFAULT_WORKSPACE_PATH=

# RAG & Knowledge Engine
RAG_ENABLED=true
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_TOP_K=10
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_BATCH_SIZE=32

